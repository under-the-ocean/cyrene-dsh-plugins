{
  "name": "@dsh-local/cyrene-skin",
  "version": "0.1.0",
  "description": "昔涟 (Cyrene) pearl-white skin for the dsh web GUI — maps Cyrene-Agent's white + pink palette onto the DSH design tokens via theme.overrideTokens",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "theme",
    "skin",
    "cyrene"
  ],
  "license": "MIT"
}
